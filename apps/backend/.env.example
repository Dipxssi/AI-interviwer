# Postgres connection string (local docker-compose or Render Postgres)
DATABASE_URL=postgresql://interviwer:interviwer@localhost:5434/interviwer

# Comma-separated browser origins allowed by CORS
FRONTEND_URL=http://localhost:3000

# Server listen port (Render sets PORT automatically)
PORT=3001

# Third-party APIs
GROQ_API_KEY=
DEEPGRAM_API_KEY=
